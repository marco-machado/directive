{
  "name": "neon-directive",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --test --experimental-transform-types tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false worker/worker-configuration.d.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "patch-package": "8.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.151.0"
  }
}
